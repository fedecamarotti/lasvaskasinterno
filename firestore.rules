rules_version = '2';
// Reglas de seguridad para LASVASKAS (proyecto Firebase "internovaskas").
// Solo pueden leer/escribir los usuarios autenticados que además tengan su documento en usuarios/{uid}.
// Se pegan en Firebase Console > Firestore Database > Reglas. Probar primero en un proyecto de prueba.
service cloud.firestore {
  match /databases/{database}/documents {

    function esUsuarioDelSistema() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Cada persona puede leer su propio rol; nadie puede cambiarlo desde la web (se edita solo desde la consola).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /meta/{doc} {
      allow read, write: if esUsuarioDelSistema();
    }

    function esAdmin() {
      return esUsuarioDelSistema()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Eliminar una clienta: solo el administrador (leer, crear y editar: todos los usuarios del sistema).
    match /clientas/{clientaId} {
      allow read, create, update: if esUsuarioDelSistema();
      allow delete: if esAdmin();
      match /documentos/{docId} {
        allow read, create, update: if esUsuarioDelSistema();
        // Ventas y presupuestos: solo el administrador puede eliminarlos (pagos y notas, cualquiera del sistema)
        allow delete: if esAdmin() || (esUsuarioDelSistema() && !(resource.data.tipo in ['venta','presupuesto']));
        match /fotos/{fotoId} {
          allow read, write: if esUsuarioDelSistema();
        }
      }
    }

    // Planillas globales de presupuestos y ventas: eliminar, solo el administrador.
    match /presupuestos/{id} {
      allow read, create, update: if esUsuarioDelSistema();
      allow delete: if esAdmin();
    }

    match /ventas/{id} {
      allow read, create, update: if esUsuarioDelSistema();
      allow delete: if esAdmin();
    }

    // Telas/Arreglos ("egresos"): lo carga el administrador; "full" solo puede leerlo y pasar registros a pagado desde Egresos.
    match /egresos/{id} {
      allow read: if esUsuarioDelSistema()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin','full'];
      allow write: if esUsuarioDelSistema()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin','full'];
    }

    // Egresos del mes ("gastos") y sus conceptos: admin y full.
    match /gastos/{id} {
      allow read, write: if esUsuarioDelSistema()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin','full'];
    }
    match /conceptos/{id} {
      allow read, write: if esUsuarioDelSistema()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin','full'];
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
